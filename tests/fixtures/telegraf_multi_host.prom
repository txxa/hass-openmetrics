# Untyped samples without HELP/TYPE, two hosts, per-core CPU samples only for host "beta"
cpu_usage_idle{cpu="cpu-total",host="alpha"} 90
cpu_usage_idle{cpu="cpu0",host="alpha"} 85
cpu_usage_idle{cpu="cpu1",host="alpha"} 95
cpu_usage_idle{cpu="cpu0",host="beta"} 60
cpu_usage_idle{cpu="cpu1",host="beta"} 80
cpu_usage_idle{cpu="cpu2",host="beta"} 100
mem_total{host="alpha"} 8e+09
mem_available{host="alpha"} 6e+09
mem_total{host="beta"} 4e+09
mem_available{host="beta"} 1e+09
swap_total{host="alpha"} 0
swap_used{host="alpha"} 0
swap_used_percent{host="alpha"} 0
swap_total{host="beta"} 2e+09
swap_used{host="beta"} 5e+08
swap_used_percent{host="beta"} 25
system_load1{host="alpha"} 0
system_load1{host="beta"} 1.5
disk_total{device="sda1",host="alpha",path="/"} 1e+11
disk_free{device="sda1",host="alpha",path="/"} 4e+10
disk_total{device="sda2",host="alpha",path="/srv/data"} 5e+11
disk_free{device="sda2",host="alpha",path="/srv/data"} 5e+11
net_bytes_recv{host="alpha",interface="bond0"} 1000
net_bytes_recv{host="alpha",interface="tun0"} 0
net_bytes_sent{host="alpha",interface="bond0"} 2000
net_bytes_sent{host="alpha",interface="tun0"} 0
net_bytes_recv{host="beta",interface="enp3s0"} 5000
net_bytes_sent{host="beta",interface="enp3s0"} 6000
system_uptime{host="alpha"} 100
system_uptime{host="beta"} 200
